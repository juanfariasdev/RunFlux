{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist",
    "strict": true,
    "composite": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ]
  },
  "references": [
    {
      "path": "../../packages/runtime"
    },
    {
      "path": "../../packages/plugin-system"
    }
  ],
  "include": [
    "*.ts",
    "__tests__/**/*.ts"
  ]
}
