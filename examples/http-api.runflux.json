        "id": "health-summary",
        "pluginId": "code-javascript",
        "pluginVersion": "1.0.0",
        "parameters": {
          "code": "// A node with several parents receives their outputs as a list, in connection order.\nconst responses = Array.isArray($json) ? $json : [$json];\nreturn {\n  healthy: responses.every((response) => response.status >= 200 && response.status < 300),\n  checks: responses.map((response) => ({ method: response.body.method, status: response.status })),\n};"
