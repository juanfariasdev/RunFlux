{
  "$schema": "https://runflux.dev/schemas/v1/workflow-project.json",
  "schemaVersion": 1,
  "exportedAt": "2026-09-24T00:00:00.000Z",
  "project": {
    "name": "Example - HTTP API",
    "envVars": [
      {
        "key": "ITEMS_API_KEY",
        "value": "change-me",
        "description": "Secret the PUT and PATCH /items endpoints expect in the X-Api-Key header"
      },
      {
        "key": "UPSTREAM_URL",
        "value": "https://httpbin.org/anything",
        "description": "Base URL of the API that /proxy and /upstream/health call; httpbin echoes each request back"
      }
    ]
  },
  "workflow": {
    "id": "example-http-api",
    "name": "Example - HTTP API",
    "nodes": [
      {
        "id": "list-items",
        "pluginId": "trigger-webhook",
        "pluginVersion": "1.0.0",
        "parameters": {
          "path": "/items",
          "httpMethod": "GET",
          "rawBody": false,
          "authentication": "none",
          "sampleBody": [
            {
              "name": "message",
              "value": "Sample webhook payload",
              "type": "string"
            }
          ],
          "sampleHeaders": {
            "content-type": "application/json"
          },
          "sampleQuery": {
            "category": "hardware"
          }
        },
        "position": {
          "x": 0,
          "y": 0
        },
        "appearance": {
          "label": "GET /items",
          "color": "#4f46e5"
        }
      },
      {
        "id": "filter-catalog",
        "pluginId": "code-javascript",
        "pluginVersion": "1.0.0",
        "parameters": {
          "code": "const catalog = [\n  { id: 1, name: 'Keyboard', category: 'hardware', price: 49.9 },\n  { id: 2, name: 'Mouse', category: 'hardware', price: 19.9 },\n  { id: 3, name: 'IDE license', category: 'software', price: 99 },\n];\nconst { category, limit } = $json._query;\nconst matching = catalog.filter((item) => !category || item.category === category);\nconst items = limit ? matching.slice(0, Number(limit)) : matching;\nreturn { items, count: items.length, filters: { category: category ?? null, limit: limit ? Number(limit) : null } };"
        },
        "position": {
          "x": 320,
          "y": 0
        },
        "appearance": {
          "label": "Filter the catalog",
          "color": "#10b981"
        }
      },
      {
        "id": "create-item",
        "pluginId": "trigger-webhook",
        "pluginVersion": "1.0.0",
        "parameters": {
          "path": "/items",
          "httpMethod": "POST",
          "rawBody": false,
          "authentication": "none",
          "sampleBody": [
            {
              "name": "name",
              "value": "Monitor",
              "type": "string"
            },
            {
              "name": "price",
              "value": "899.9",
              "type": "number"
            }
          ],
          "sampleHeaders": {
            "content-type": "application/json"
          },
          "sampleQuery": {}
        },
        "position": {
          "x": 0,
          "y": 315
        },
        "appearance": {
          "label": "POST /items",
          "color": "#4f46e5"
        }
      },
      {
        "id": "validate-item",
        "pluginId": "condition-if",
        "pluginVersion": "1.0.0",
        "parameters": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "{{ $json.name }}",
              "operator": "isNotEmpty"
            },
            {
              "leftValue": "{{ $json.price }}",
              "operator": "greaterThan",
              "rightValue": "0"
            }
          ]
        },
        "position": {
          "x": 320,
          "y": 315
        },
        "appearance": {
          "label": "Name and positive price?"
        }
      },
      {
        "id": "item-created",
        "pluginId": "set",
        "pluginVersion": "1.0.0",
        "parameters": {
          "fields": [
            {
              "name": "status",
              "value": "created",
              "type": "string"
            },
            {
              "name": "name",
              "value": "{{ $json.name.trim() }}",
              "type": "string"
            },
            {
              "name": "price",
              "value": "{{ $json.price }}",
              "type": "number"
            },
            {
              "name": "slug",
              "value": "{{ $json.name.trim().toLowerCase().replace(/\\s+/g, '-') }}",
              "type": "string"
            }
          ],
          "includeOtherFields": false
        },
        "position": {
          "x": 640,
          "y": 240
        },
        "appearance": {
          "label": "Created item",
          "color": "#10b981"
