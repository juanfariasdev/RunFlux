        "pluginVersion": "1.0.0",
        "parameters": {
          "databaseType": "postgres",
          "connectionEnvVar": "{{$env.DATABASE_URL}}",
          "query": "TRUNCATE products RESTART IDENTITY",
          "queryParams": [],
          "outputMode": "all"
        },
        "position": {
          "x": 320,
          "y": 240
        },
        "appearance": {
          "label": "Remove every product"
