          "path": "/products",
          "httpMethod": "POST",
          "rawBody": false,
          "authentication": "none",
          "sampleBody": [
            {
              "name": "sku",
              "value": "KB-1",
              "type": "string"
            },
            {
              "name": "name",
              "value": "Keyboard",
              "type": "string"
            },
            {
              "name": "price",
              "value": "49.9",
              "type": "number"
            },
            {
              "name": "tags",
              "value": [
                "hardware"
              ],
              "type": "array"
            }
          ],
          "sampleHeaders": {
            "content-type": "application/json"
          },
          "sampleQuery": {}
        },
        "position": {
          "x": 0,
          "y": 555
        },
        "appearance": {
          "label": "POST /products",
          "color": "#4f46e5"
        }
      },
      {
        "id": "valid-product",
        "pluginId": "condition-if",
        "pluginVersion": "1.0.0",
        "parameters": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "{{ $json.sku }}",
              "operator": "isNotEmpty"
            },
            {
              "leftValue": "{{ $json.name }}",
              "operator": "isNotEmpty"
            },
            {
              "leftValue": "{{ $json.price }}",
              "operator": "greaterThanOrEqual",
              "rightValue": "0"
            }
          ]
        },
        "position": {
          "x": 320,
          "y": 555
        },
        "appearance": {
          "label": "sku, name and price?"
        }
      },
      {
        "id": "insert-product",
        "pluginId": "database-query",
        "pluginVersion": "1.0.0",
        "parameters": {
          "databaseType": "postgres",
          "connectionEnvVar": "{{$env.DATABASE_URL}}",
          "query": "INSERT INTO products (sku, name, price, tags)\nVALUES ($1, $2, $3, $4::jsonb)\nRETURNING *",
          "queryParams": [
            "{{ $json.sku }}",
            "{{ $json.name }}",
            "{{ $json.price }}",
            "{{ JSON.stringify($json.tags ?? []) }}"
          ],
          "outputMode": "first"
        },
        "position": {
          "x": 640,
          "y": 480
        },
        "appearance": {
          "label": "INSERT … RETURNING *",
          "color": "#10b981"
        }
      },
      {
        "id": "invalid-product",
