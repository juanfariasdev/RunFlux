{
  "$schema": "https://runflux.dev/schemas/v1/workflow-project.json",
  "schemaVersion": 1,
  "exportedAt": "2026-09-24T00:00:00.000Z",
  "project": {
    "name": "Example - PostgreSQL CRUD",
    "envVars": [
      {
        "key": "DATABASE_URL",
        "value": "postgres://postgres:postgres@localhost:5432/runflux",
        "description": "PostgreSQL connection string; inside Docker Compose use the host postgres instead of localhost"
      },
      {
        "key": "ADMIN_KEY",
        "value": "change-me",
        "description": "Secret the /setup, /setup/reset and /products/reprice endpoints expect in the X-Admin-Key header"
      }
    ]
  },
  "workflow": {
    "id": "example-database-crud",
    "name": "Example - PostgreSQL CRUD",
    "nodes": [
      {
        "id": "setup",
        "pluginId": "trigger-webhook",
        "pluginVersion": "1.0.0",
        "parameters": {
          "path": "/setup",
          "httpMethod": "POST",
          "rawBody": false,
          "authentication": "headerAuth",
          "headerName": "X-Admin-Key",
          "secretEnvVar": "ADMIN_KEY",
          "sampleBody": [],
          "sampleHeaders": {
            "content-type": "application/json"
          },
          "sampleQuery": {}
        },
        "position": {
          "x": 0,
          "y": 0
        },
        "appearance": {
          "label": "POST /setup (X-Admin-Key)",
          "color": "#4f46e5"
        }
      },
      {
        "id": "create-schema",
        "pluginId": "database-query",
        "pluginVersion": "1.0.0",
        "parameters": {
          "databaseType": "postgres",
          "connectionEnvVar": "{{$env.DATABASE_URL}}",
          "query": "CREATE TABLE IF NOT EXISTS products (\n  id serial PRIMARY KEY,\n  sku text NOT NULL UNIQUE,\n  name text NOT NULL,\n  price numeric(10, 2) NOT NULL CHECK (price >= 0),\n  tags jsonb NOT NULL DEFAULT '[]',\n  active boolean NOT NULL DEFAULT true,\n  created_at timestamptz NOT NULL DEFAULT now(),\n  updated_at timestamptz\n);\nCREATE INDEX IF NOT EXISTS products_active_idx ON products (active);",
          "queryParams": [],
          "outputMode": "all"
        },
        "position": {
          "x": 320,
          "y": 0
        },
        "appearance": {
          "label": "Create the products table"
        }
      },
      {
        "id": "schema-ready",
        "pluginId": "set",
        "pluginVersion": "1.0.0",
        "parameters": {
          "fields": [
            {
              "name": "ready",
              "value": "true",
              "type": "boolean"
            },
            {
              "name": "table",
              "value": "products",
              "type": "string"
            }
          ],
          "includeOtherFields": false
        },
        "position": {
          "x": 640,
          "y": 0
        },
        "appearance": {
          "label": "Schema ready",
          "color": "#10b981"
        }
      },
      {
        "id": "reset",
        "pluginId": "trigger-webhook",
        "pluginVersion": "1.0.0",
