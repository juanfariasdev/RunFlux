      },
      {
        "id": "find-product",
        "pluginId": "database-query",
        "pluginVersion": "1.0.0",
        "parameters": {
          "databaseType": "postgres",
          "connectionEnvVar": "{{$env.DATABASE_URL}}",
          "query": "SELECT * FROM products WHERE id = $1::int",
          "queryParams": [
            "{{ $json._query.id }}"
          ],
          "outputMode": "first"
        },
        "position": {
          "x": 640,
          "y": 870
        },
        "appearance": {
          "label": "SELECT one product",
          "color": "#10b981"
        }
      },
      {
        "id": "list-products",
        "pluginId": "database-query",
        "pluginVersion": "1.0.0",
        "parameters": {
          "databaseType": "postgres",
          "connectionEnvVar": "{{$env.DATABASE_URL}}",
          "query": "SELECT * FROM products\nWHERE ($1::text IS NULL OR name ILIKE '%' || $1 || '%')\n  AND ($2::boolean IS NULL OR active = $2::boolean)\nORDER BY id\nLIMIT $3::int",
          "queryParams": [
            "{{ $json._query.search ?? null }}",
            "{{ $json._query.active ?? null }}",
            "{{ $json._query.limit ?? 100 }}"
          ],
          "outputMode": "all"
        },
        "position": {
          "x": 640,
          "y": 1020
        },
        "appearance": {
          "label": "SELECT with filters",
          "color": "#10b981"
        }
      },
      {
        "id": "update-product",
        "pluginId": "trigger-webhook",
        "pluginVersion": "1.0.0",
        "parameters": {
          "path": "/products",
          "httpMethod": "PUT",
          "rawBody": false,
          "authentication": "none",
          "sampleBody": [
            {
              "name": "price",
              "value": "59.9",
              "type": "number"
            }
          ],
          "sampleHeaders": {
            "content-type": "application/json"
          },
          "sampleQuery": {
            "id": "1"
          }
        },
        "position": {
          "x": 0,
          "y": 1335
        },
        "appearance": {
          "label": "PUT /products",
          "color": "#4f46e5"
        }
      },
      {
        "id": "apply-update",
        "pluginId": "database-query",
        "pluginVersion": "1.0.0",
        "parameters": {
          "databaseType": "postgres",
          "connectionEnvVar": "{{$env.DATABASE_URL}}",
          "query": "UPDATE products SET\n  name = COALESCE($2, name),\n  price = COALESCE($3::numeric, price),\n  active = COALESCE($4::boolean, active),\n  tags = COALESCE($5::jsonb, tags),\n  updated_at = now()\nWHERE id = $1::int\nRETURNING *",
          "queryParams": [
            "{{ $json._query.id }}",
            "{{ $json.name ?? null }}",
            "{{ $json.price ?? null }}",
            "{{ $json.active ?? null }}",
            "{{ $json.tags === undefined ? null : JSON.stringify($json.tags) }}"
          ],
          "outputMode": "first"
        },
        "position": {
          "x": 320,
          "y": 1335
        },
        "appearance": {
          "label": "UPDATE … RETURNING *"
        }
      },
      {
        "id": "was-updated",
        "pluginId": "condition-if",
        "pluginVersion": "1.0.0",
        "parameters": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "{{ $json }}",
              "operator": "isNotEmpty"
            }
          ]
        },
        "position": {
          "x": 640,
          "y": 1335
