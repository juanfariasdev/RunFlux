        "id": "reprice-summary",
        "pluginId": "code-javascript",
        "pluginVersion": "1.0.0",
        "parameters": {
          "code": "return { updated: $json.length, products: $json.sort((a, b) => a.id - b.id) };"
        },
        "position": {
          "x": 640,
          "y": 2040
        },
        "appearance": {
          "label": "Summarize",
          "color": "#10b981"
        }
      },
      {
        "id": "stats",
        "pluginId": "trigger-webhook",
        "pluginVersion": "1.0.0",
        "parameters": {
          "path": "/products/stats",
          "httpMethod": "GET",
          "rawBody": false,
          "authentication": "none",
          "sampleBody": [],
          "sampleHeaders": {
            "content-type": "application/json"
          },
          "sampleQuery": {}
