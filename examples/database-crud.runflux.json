        "id": "reprice",
        "pluginId": "trigger-webhook",
        "pluginVersion": "1.0.0",
        "parameters": {
          "path": "/products/reprice",
          "httpMethod": "POST",
          "rawBody": false,
          "authentication": "headerAuth",
          "headerName": "X-Admin-Key",
          "secretEnvVar": "ADMIN_KEY",
          "sampleBody": [
            {
              "name": "percent",
              "value": "10",
              "type": "number"
            }
          ],
          "sampleHeaders": {
            "content-type": "application/json"
          },
          "sampleQuery": {}
        },
        "position": {
          "x": 0,
          "y": 2040
        },
        "appearance": {
          "label": "POST /products/reprice (X-Admin-Key)",
          "color": "#4f46e5"
        }
      },
      {
        "id": "apply-reprice",
        "pluginId": "database-query",
        "pluginVersion": "1.0.0",
        "parameters": {
          "databaseType": "postgres",
          "connectionEnvVar": "{{$env.DATABASE_URL}}",
          "query": "UPDATE products\nSET price = round(price * (1 + $1::numeric / 100), 2), updated_at = now()\nWHERE active\nRETURNING id, sku, price",
          "queryParams": [
            "{{ $json.percent }}"
          ],
          "outputMode": "all"
        },
        "position": {
