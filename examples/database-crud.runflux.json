      {
        "id": "product-stats",
        "pluginId": "database-query",
        "pluginVersion": "1.0.0",
        "parameters": {
          "databaseType": "postgres",
          "connectionEnvVar": "{{$env.DATABASE_URL}}",
          "query": "SELECT\n  count(*)::int AS total,\n  (count(*) FILTER (WHERE active))::int AS active,\n  COALESCE(sum(price) FILTER (WHERE active), 0) AS stock_value\nFROM products",
          "queryParams": [],
          "outputMode": "first"
        },
        "position": {
          "x": 320,
          "y": 2280
        },
        "appearance": {
          "label": "Count and stock value"
        }
      },
      {
        "id": "tag-list",
        "pluginId": "database-query",
        "pluginVersion": "1.0.0",
        "parameters": {
          "databaseType": "postgres",
          "connectionEnvVar": "{{$env.DATABASE_URL}}",
          "query": "SELECT DISTINCT jsonb_array_elements_text(tags) AS tag FROM products ORDER BY tag",
          "queryParams": [],
          "outputMode": "all"
        },
        "position": {
          "x": 640,
          "y": 2280
        },
        "appearance": {
          "label": "Distinct tags (jsonb)"
        }
      },
      {
        "id": "stats-response",
        "pluginId": "code-javascript",
        "pluginVersion": "1.0.0",
        "parameters": {
          "code": "// $node holds the outputs of the ancestors of this node, by id.\nreturn { ...$node['product-stats'].json, tags: $json.map((row) => row.tag) };"
        },
        "position": {
          "x": 960,
          "y": 2280
        },
        "appearance": {
          "label": "Combine both queries",
