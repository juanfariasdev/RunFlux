        "position": {
          "x": 640,
          "y": 630
        },
        "appearance": {
          "label": "Invalid product",
          "color": "#ef4444"
        }
      },
      {
        "id": "read-products",
        "pluginId": "trigger-webhook",
        "pluginVersion": "1.0.0",
        "parameters": {
          "path": "/products",
          "httpMethod": "GET",
          "rawBody": false,
          "authentication": "none",
          "sampleBody": [],
          "sampleHeaders": {
            "content-type": "application/json"
          },
          "sampleQuery": {
            "search": "key"
          }
        },
        "position": {
          "x": 0,
          "y": 945
