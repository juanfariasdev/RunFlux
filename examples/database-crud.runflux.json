        "appearance": {
          "label": "GET /products",
          "color": "#4f46e5"
        }
      },
      {
        "id": "by-id",
        "pluginId": "condition-if",
        "pluginVersion": "1.0.0",
        "parameters": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "{{ $json._query.id }}",
              "operator": "isNotEmpty"
            }
          ]
        },
        "position": {
          "x": 320,
          "y": 945
