          "rawBody": false,
          "authentication": "headerAuth",
          "headerName": "X-Admin-Key",
          "secretEnvVar": "ADMIN_KEY",
          "sampleBody": [],
          "sampleHeaders": {
            "content-type": "application/json"
          },
          "sampleQuery": {}
        },
        "position": {
          "x": 0,
          "y": 240
        },
        "appearance": {
          "label": "POST /setup/reset (X-Admin-Key)",
          "color": "#4f46e5"
        }
      },
      {
        "id": "truncate-products",
