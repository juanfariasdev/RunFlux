      {
        "id": "digest-schedule",
        "pluginId": "trigger-cron",
        "pluginVersion": "1.0.0",
        "parameters": {
          "expression": "0 */6 * * *",
          "timezone": "UTC"
        },
        "position": {
          "x": 0,
