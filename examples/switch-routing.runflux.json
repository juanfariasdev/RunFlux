  "workflow": {
    "id": "example-switch-routing",
    "name": "Example - Switch routing",
    "nodes": [
      {
        "id": "new-ticket",
        "pluginId": "trigger-webhook",
        "pluginVersion": "1.0.0",
        "parameters": {
          "path": "/tickets",
          "httpMethod": "POST",
          "rawBody": false,
          "authentication": "none",
          "sampleBody": [
            {
              "name": "subject",
              "value": "Refund request",
              "type": "string"
            },
            {
              "name": "amount",
              "value": "120",
              "type": "number"
            }
          ],
          "sampleHeaders": {
            "content-type": "application/json"
          },
          "sampleQuery": {}
        },
        "position": {
          "x": 0,
          "y": 525
        },
        "appearance": {
          "label": "POST /tickets",
          "color": "#4f46e5"
        }
      },
      {
        "id": "route-ticket",
        "pluginId": "condition-switch",
        "pluginVersion": "1.0.0",
        "parameters": {
          "fallbackEnabled": true,
          "rules": [
            {
              "combinator": "or",
              "conditions": [
                {
                  "leftValue": "{{ $json.priority }}",
                  "operator": "equals",
                  "rightValue": "urgent"
                },
                {
                  "leftValue": "{{ $json.customer?.tier }}",
                  "operator": "equals",
                  "rightValue": "vip"
                }
              ]
            },
            {
              "combinator": "and",
              "conditions": [
                {
                  "leftValue": "{{ ($json.subject ?? '').toLowerCase() }}",
                  "operator": "contains",
                  "rightValue": "refund"
                },
                {
                  "leftValue": "{{ $json.amount }}",
                  "operator": "greaterThan",
                  "rightValue": "0"
                }
              ]
            },
            {
              "combinator": "and",
              "conditions": [
                {
                  "leftValue": "{{ $json.email }}",
                  "operator": "endsWith",
                  "rightValue": "@partner.com"
                }
              ]
            },
            {
              "combinator": "and",
              "conditions": [
                {
                  "leftValue": "{{ $json.tags ?? [] }}",
                  "operator": "contains",
                  "rightValue": "bug"
                }
              ]
            },
            {
              "combinator": "and",
              "conditions": [
                {
                  "leftValue": "{{ $json.score }}",
                  "operator": "lessThanOrEqual",
                  "rightValue": "3"
                }
              ]
            }
          ]
        },
        "position": {
          "x": 320,
          "y": 525
        },
        "appearance": {
          "label": "Route the ticket"
        }
      },
      {
        "id": "queue-urgent",
        "pluginId": "set",
        "pluginVersion": "1.0.0",
        "parameters": {
          "fields": [
            {
              "name": "queue",
              "value": "urgent",
              "type": "string"
            },
            {
              "name": "sla",
              "value": "1h",
              "type": "string"
            },
            {
              "name": "subject",
              "value": "{{ $json.subject ?? '(no subject)' }}",
              "type": "string"
            }
          ],
          "includeOtherFields": false
        },
        "position": {
          "x": 640,
          "y": 0
        },
        "appearance": {
          "label": "Urgent queue",
          "color": "#10b981"
        }
      },
      {
        "id": "refund-size",
        "pluginId": "condition-if",
        "pluginVersion": "1.0.0",
        "parameters": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "{{ $json.amount }}",
              "operator": "greaterThan",
              "rightValue": "1000"
            }
          ]
        },
        "position": {
          "x": 640,
          "y": 225
        },
        "appearance": {
          "label": "Refund above 1000?"
        }
      },
