      {
        "id": "triage-ticket",
        "pluginId": "trigger-webhook",
        "pluginVersion": "1.0.0",
        "parameters": {
          "path": "/tickets/triage",
          "httpMethod": "POST",
          "rawBody": false,
          "authentication": "none",
          "sampleBody": [
            {
              "name": "status",
              "value": "open",
              "type": "string"
            },
            {
              "name": "title",
              "value": "Login fails",
              "type": "string"
            }
          ],
          "sampleHeaders": {
            "content-type": "application/json"
          },
          "sampleQuery": {}
        },
        "position": {
          "x": 0,
          "y": 1590
        },
        "appearance": {
          "label": "POST /tickets/triage",
          "color": "#4f46e5"
        }
      },
      {
        "id": "triage",
        "pluginId": "condition-switch",
        "pluginVersion": "1.0.0",
        "parameters": {
          "fallbackEnabled": false,
          "rules": [
            {
              "combinator": "and",
              "conditions": [
                {
                  "leftValue": "{{ $json.status }}",
                  "operator": "notEquals",
                  "rightValue": "closed"
                },
                {
                  "leftValue": "{{ $json.assignee }}",
                  "operator": "isEmpty"
                }
              ]
            },
            {
              "combinator": "and",
              "conditions": [
                {
                  "leftValue": "{{ $json.title ?? '' }}",
                  "operator": "startsWith",
                  "rightValue": "[SEC]"
                }
              ]
            },
            {
              "combinator": "and",
              "conditions": [
                {
                  "leftValue": "{{ $json.body ?? '' }}",
                  "operator": "regex",
                  "rightValue": "crash|exception|stack trace"
                }
              ]
            },
            {
              "combinator": "and",
              "conditions": [
                {
                  "leftValue": "{{ $json.votes }}",
                  "operator": "greaterThanOrEqual",
                  "rightValue": "10"
                }
              ]
            },
            {
              "combinator": "and",
              "conditions": [
                {
                  "leftValue": "{{ $json.status }}",
                  "operator": "equals",
                  "rightValue": "open"
                },
                {
                  "leftValue": "{{ $json.labels ?? [] }}",
                  "operator": "notContains",
                  "rightValue": "wontfix"
                }
              ]
            }
          ]
        },
        "position": {
          "x": 320,
          "y": 1590
        },
        "appearance": {
          "label": "Triage (no fallback)"
        }
      },
