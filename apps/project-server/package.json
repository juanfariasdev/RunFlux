{
  "name": "@runflux/project-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --force --pretty false",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init_project_management",
    "db:studio": "prisma studio",
    "clean:output": "node -e \"const fs = require('fs'); const p = require('path').resolve(process.cwd(), 'output-backends'); if (fs.existsSync(p)) { fs.rmSync(p, { recursive: true, force: true }); console.log('[clean:output] output-backends cleaned.'); }\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@runflux/workflow-model": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8",
    "jszip": "^3.10.1",
    "@runflux/compiler": "*",
    "@runflux/plugin-system": "*"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.9"
  }
}
