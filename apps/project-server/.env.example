DATABASE_URL="file:./dev.db"
PORT=3001

# Endereço em que o servidor escuta. Sem HOST, só esta máquina o alcança (127.0.0.1).
# Um endereço de rede, como 0.0.0.0, exige RUNFLUX_API_TOKEN.
# HOST=0.0.0.0

# Token bearer exigido em /api/* sempre que definido; no mínimo 32 caracteres.
# O editor pede o token uma vez por sessão do navegador. Gere um com: openssl rand -base64 32
# Prefira exportá-lo no shell: o apps/project-server/.env deste repositório é versionado.
# Defina-o também atrás de um proxy reverso nesta máquina, que faz toda requisição chegar por loopback.
# RUNFLUX_API_TOKEN=

# Origens que podem ler as respostas de um navegador, separadas por vírgula. Vazio por padrão:
# o editor chama pela própria origem, que repassa /api.
# RUNFLUX_CORS_ORIGINS=https://ferramenta.exemplo

# Maior corpo JSON aceito (padrão 5mb).
# RUNFLUX_BODY_LIMIT=5mb

# Chave que cifra os valores das variáveis dos projetos: 32 bytes em base64. Sem ela, a chave é
# gerada em ~/.runflux/secret.key na primeira execução. Guarde esse arquivo junto com o banco:
# sem ele, os valores guardados não podem ser lidos.
# RUNFLUX_SECRET_KEY=

# Pasta que substitui a pasta do usuário para .runflux/secret.key.
# RUNFLUX_HOME=
