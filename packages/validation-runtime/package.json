{
  "name": "@runflux/validation-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": {
      "types": "./node.d.ts",
      "import": "./dist-node/index.mjs"
    },
    "./engine": "./src/engine.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json",
    "build:node": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist-node/index.mjs"
  },
  "dependencies": {
    "@runflux/plugin-system": "*",
    "@runflux/runtime": "*",
    "@runflux/workflow-model": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.9",
    "@types/node": "^22.5.0"
  }
}
