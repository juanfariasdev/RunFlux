{
  "name": "@runflux/plugin-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": {
      "types": "./node.d.ts",
      "import": "./dist-node/index.mjs"
    },
    "./types": "./src/types.ts",
    "./condition-row-schema": "./src/condition-row-schema.ts",
    "./fields-row-schema": "./src/fields-row-schema.ts",
    "./manifest-validator": "./src/manifest-validator.ts",
    "./manifest-serializer": "./src/manifest-serializer.ts",
    "./plugin-registry": "./src/plugin-registry.ts",
    "./discovery/directory-scanner": "./src/discovery/directory-scanner.ts",
    "./discovery/package-scanner": "./src/discovery/package-scanner.ts",
    "./discovery/logger": "./src/discovery/logger.ts",
    "./api/list-plugins": "./src/api/list-plugins.ts",
    "./api/resolve-generator": "./src/api/resolve-generator.ts",
    "./api/resolve-executor": "./src/api/resolve-executor.ts",
    "./operators": "./src/operators.ts",
    "./context-helpers": "./src/context-helpers.ts",
    "./evaluator": "./src/evaluator.ts",
    "./snippets": "./src/snippets.ts",
    "./code-generators": "./src/code-generators.ts",
    "./generators": "./src/code-generators.ts",
    "./standalone": "./src/standalone.ts",
    "./http-client": "./src/http-client.ts",
    "./webhook-config": "./src/webhook-config.ts",
    "./testing": "./src/testing.ts",
    "./generator-factory": "./src/generator-factory.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json",
    "build:node": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist-node/index.mjs --external:zod --external:esbuild --external:tsx"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^4.1.9",
    "@types/node": "^22.5.0"
  }
}
