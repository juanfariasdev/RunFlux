{
  "name": "@runflux/plugin-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": {
      "types": "./node.d.ts",
      "import": "./dist-node/index.mjs"
    },
    "./types": "./src/types.ts",
    "./deployment": "./src/deployment.ts",
    "./condition-row-schema": "./src/condition-row-schema.ts",
    "./fields-row-schema": "./src/fields-row-schema.ts",
    "./manifest-validator": "./src/manifest-validator.ts",
    "./manifest-serializer": "./src/manifest-serializer.ts",
    "./plugin-registry": "./src/plugin-registry.ts",
    "./discovery/directory-scanner": "./src/discovery/directory-scanner.ts",
    "./discovery/package-scanner": "./src/discovery/package-scanner.ts",
    "./discovery/logger": "./src/discovery/logger.ts",
    "./api/list-plugins": "./src/api/list-plugins.ts",
    "./api/check-plugin-reference": "./src/api/check-plugin-reference.ts",
    "./webhook-test-hub": "./src/webhook-test-hub.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json",
    "build:node": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist-node/index.mjs --external:zod --external:tsx"
  },
  "dependencies": {
    "@runflux/runtime": "*",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^4.1.9",
    "@types/node": "^22.5.0"
  }
}
